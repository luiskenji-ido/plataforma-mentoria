# Modelo de configuração da plataforma. Copie para .env (desenvolvimento) ou passe como variáveis de ambiente
# (contêiner, AWS, PythonAnywhere). SÓ valores de exemplo: nunca coloque um .env preenchido no Git.
# A mesma imagem roda em dev, homologação e produção: tudo o que muda entre eles está aqui.

# ---------------------------------------------------------------- essenciais
# Chave das sessões, do CSRF e da cifra das credenciais guardadas no banco. Obrigatória no contêiner
# (mínimo 32 caracteres). Gere com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_POR_UMA_CHAVE_LONGA_E_ALEATORIA
# Banco. Sem ela, o SQLite de desenvolvimento (instance/mentoria.db).
DATABASE_URL=mysql+pymysql://mentoria:TROQUE_A_SENHA@db:3306/mentoria?charset=utf8mb4
# Endereço público (links nos e-mails, convites e certificados)
APP_BASE_URL=https://mentoria.exemplo.org.br
# Produção: HTTPS atrás do proxy, cookies seguros, contas de teste (@local.com) bloqueadas e OAuth só com HTTPS
MENTORIA_PRODUCAO=1
# O proxy/balanceador repassa o IP real de cada pessoa (limite de tentativas de login por IP)
ATRAS_DE_PROXY=1
# servidor, aws_vm, gcp_vm, azure_vm, aws_conteiner, gcp_conteiner, azure_conteiner, pythonanywhere
HOSPEDAGEM=aws_conteiner

# ---------------------------------------------------------------- banco (pool de conexões, só MySQL/PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=280
# 1 (padrão) = aplica as migrações ao subir; 0 = só pelo comando "flask db upgrade" (recomendado com várias réplicas)
MIGRAR_AO_INICIAR=1
# Tempos-limite (segundos): espera por conexão livre do pool, abrir conexão, ler e escrever (MySQL)
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=60
DB_WRITE_TIMEOUT=60

# ---------------------------------------------------------------- e-mail (SMTP), opcional
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_REMETENTE=
MAIL_NOME_REMETENTE=

# ---------------------------------------------------------------- integrações, opcionais
# Google (Agenda e Gmail): caminho do client_secret.json montado como segredo (no contêiner, nunca na imagem)
GOOGLE_CLIENT_SECRETS_FILE=/run/secrets/google_client_secret.json
# Microsoft 365 (Agenda e e-mail pelo Graph)
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TENANT=
# IAs (também podem ser cadastradas na tela Provedores de IA e custos › Credenciais, cifradas no banco)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Agente de Preços e Modelos de IA: outra tabela de preços (JSON no formato da LiteLLM); vazio = a padrão
PRECOS_IA_FONTE_URL=

# ---------------------------------------------------------------- arquivos enviados (aulas, anexos, gravações, TCC, acervo, logos)
# local (padrão: pasta uploads/) ou s3 (bucket compatível com S3: AWS S3 na nuvem, MinIO no docker-compose)
ARMAZENAMENTO=s3
S3_BUCKET=mentoria-arquivos
S3_PREFIXO=
S3_REGIAO=us-east-1
# Só para MinIO ou outro compatível; na AWS fica vazio. Credenciais: papel IAM da tarefa (na AWS) ou
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY fora dela.
S3_ENDPOINT=
# Pasta dos arquivos quando ARMAZENAMENTO=local (padrão: uploads/ da plataforma)
PASTA_UPLOADS=

# ---------------------------------------------------------------- Redis (limite de tentativas de login compartilhado
# entre as réplicas e batimento das tarefas). Sem ele: limite por processo (PythonAnywhere, um servidor só).
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- backups
# Contêiner: os backups do banco ficam com o serviço gerenciado (snapshots do RDS); 1 só com volume persistente
DISCO_PERSISTENTE=0
BACKUP_DIR=
BACKUP_DIR_EXTERNO=

# ---------------------------------------------------------------- servidor web e worker (contêiner)
PORT=8080
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
# Depois dos workers, até quantos segundos esperar os clientes terminarem de receber as respostas já escritas
GUNICORN_PRAZO_ENTREGA=8
# IPs do balanceador em que se confia para X-Forwarded-* (ex.: faixa da VPC)
FORWARDED_ALLOW_IPS=127.0.0.1
# 0 = o processo web só atende pedidos; backups, lembretes e requisições de mudança rodam no worker
#     (python tarefas_agendadas.py --continuo). Sem a variável: tudo no mesmo processo (PythonAnywhere, servidor).
MENTORIA_TAREFAS_NO_WEB=0
TAREFAS_INTERVALO_SEGUNDOS=3600

# ---------------------------------------------------------------- logs (JSON na saída padrão)
LOG_FORMATO=json
LOG_LEVEL=INFO
# 1 = inclui a pilha (stack trace) das exceções no log; só para depuração
LOG_TRACEBACK=0

# ---------------------------------------------------------------- desenvolvimento
# Depurador interativo do Flask (nunca em produção)
FLASK_DEBUG=0
