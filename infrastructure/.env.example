# Painel de infraestrutura — variáveis opcionais (copie para .env só se precisar mudar o padrão).
# Nunca coloque credenciais da AWS aqui: use um perfil da AWS CLI, o SSO ou as credenciais temporárias na tela.

# Senha que cifra os segredos do estado do Pulumi. Se não definir, informe na tela Configurações (fica só na memória).
# PULUMI_CONFIG_PASSPHRASE=

# Endereço da API. O padrão é só local (127.0.0.1). Expor na rede exige INFRA_ALLOW_NETWORK=1 (não recomendado).
# INFRA_HOST=127.0.0.1
# INFRA_API_PORT=3001        # em desenvolvimento (o Vite abre o painel em 3000); em produção o padrão é 3000
# INFRA_PUBLIC_PORT=3000

# Repositório da aplicação (padrão: a pasta acima de infrastructure/) e pasta de estado (padrão: infrastructure/.state)
# APP_REPO_ROOT=
# INFRA_STATE_DIR=
