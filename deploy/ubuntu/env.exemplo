# Copie para /srv/mentoria/.env (chmod 600, dono: usuário mentoria) e preencha.
# Nunca coloque este arquivo preenchido no Git.

# Banco de dados (MySQL no mesmo servidor). A senha não pode ter @ : / ? # sem codificar (use letras, números, - e _).
DATABASE_URL=mysql+pymysql://mentoria:TROQUE_A_SENHA@localhost:3306/mentoria?charset=utf8mb4

# Chave das sessões e do CSRF: gere com  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_POR_UMA_CHAVE_LONGA

# Endereço público (links nos e-mails e convites)
APP_BASE_URL=https://mentoria.exemplo.org.br

# Marca de produção: HTTPS atrás do proxy, cookies seguros e contas de teste (@local.com) bloqueadas
MENTORIA_PRODUCAO=1
# O nginx do servidor repassa o IP real de cada pessoa (limitador de tentativas de login)
ATRAS_DE_PROXY=1

# E-mail (SMTP) — opcional
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_REMETENTE=
MAIL_NOME_REMETENTE=

# IAs — opcional (também podem ser cadastradas na tela Agentes IA › Credenciais)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
