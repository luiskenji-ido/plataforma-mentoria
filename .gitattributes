# Arquivos que rodam no Linux (servidor, contêiner) sempre com fim de linha LF, mesmo vindos do Windows
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
deploy/** text eol=lf

# Binários nunca são texto (a regra deploy/** acima trocava CRLF dentro de .docx/.png e corrompia os arquivos)
*.docx binary
*.pptx binary
*.xlsx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
